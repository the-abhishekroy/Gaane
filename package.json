{
  "name": "gaane",
  "version": "1.0.0",
  "main": "main.js",
  "bin": {
    "gaane": "./cli.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder",
    "release": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "dist:dmg": "electron-builder --mac dmg --arm64 --publish never && rm -rf dist/mac-arm64 dist/builder-debug.yml dist/latest-mac.yml"
  },
  "keywords": [],
  "author": {
    "name": "Abhishek Roy",
    "url": "https://www.abhishekkroy.me"
  },
  "license": "MIT",
  "description": "Gaane - music player.",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "cfonts": "^3.3.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "hls.js": "^1.7.1",
    "tone": "^15.1.22"
  },
  "productName": "Gaane",
  "homepage": "https://github.com/the-abhishekroy/Gaane",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-abhishekroy/Gaane.git"
  },
  "bugs": {
    "url": "https://github.com/the-abhishekroy/Gaane/issues"
  },
  "build": {
    "appId": "io.github.rootscripts.gaane",
    "productName": "Gaane",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!.github/**",
      "!dist/**",
      "!bin/**",
      "!*.md",
      "!strip_comments.js",
      "!.riff_progress.md",
      "!package-lock.json",
      "!build/**",
      "!docs/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "assets/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "the-abhishekroy",
        "repo": "Gaane",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "writeUpdateInfo": false,
      "background": "build/dmg-background.png",
      "window": {
        "width": 660,
        "height": 390
      },
      "iconSize": 84,
      "iconTextSize": 12,
      "contents": [
        {
          "x": 170,
          "y": 172,
          "type": "file"
        },
        {
          "x": 490,
          "y": 172,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
